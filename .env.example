# =============================================================================
# DigiMithra Social Pilot — environment variables (NO real secrets here)
# Copy to apps/api/.env for local development.  In Render, set these per service.
# =============================================================================

# ---- API (apps/api) ----------------------------------------------------------
APP_ENV=local                      # local | test | staging | production
PORT=8080
LOG_LEVEL=info
TRUST_PROXY=0                      # set to 1 on Render (one proxy hop)
WEB_ORIGINS=http://localhost:5173  # prod: https://socialpilot.digimithra.co.in
PUBLIC_WEB_URL=http://localhost:5173
COOKIE_DOMAIN=                     # prod: leave empty (cookie scoped to the API host)

# Database
DATABASE_DRIVER=pglite             # pglite (local, embedded) | pg (staging/prod)
PGLITE_DATA_DIR=./.data/pglite
DATABASE_URL=                      # prod: Supabase *session pooler* or direct connection string (postgres role)
DB_AUTO_MIGRATE=true               # prod: false — run `supabase db push` in the release step instead

# Auth
AUTH_PROVIDER=local                # local (dev/test only) | supabase (staging/prod)
LOCAL_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
LOCAL_AUTO_VERIFY_EMAIL=true
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
SUPABASE_URL=                      # https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=          # sb_publishable_... (server-side use only in this architecture)
SUPABASE_JWT_SECRET=               # optional: only for legacy HS256 projects; otherwise JWKS is used
ADMIN_REQUIRE_MFA=true

# Encryption for integration credentials (Meta tokens, Gemini keys...)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=

PUBLIC_API_URL=http://localhost:8080  # prod: https://api.socialpilot.digimithra.co.in (shown as the Meta webhook URL)

# ---- WhatsApp (Meta Cloud API) -------------------------------------------------
META_APP_SECRET=                   # Meta app → Settings → Basic → App secret (validates X-Hub-Signature-256)
META_WEBHOOK_VERIFY_TOKEN=         # any long random string; paste the same value in Meta's webhook config
META_GRAPH_API_VERSION=v23.0       # set to the latest version in Meta's Graph API changelog
ALLOW_MOCK_WHATSAPP=true           # mock provider for dev/staging demos; MUST be false in production

# ---- AI Center (Phase 5) ----------------------------------------------------------
AI_PROVIDER=mock                   # mock (offline, quotes your knowledge base) | gemini | disabled. Production: gemini or disabled
GEMINI_API_KEY=                    # Google AI Studio / Vertex key (use a paid tier so prompts are not used for training)
GEMINI_MODEL=gemini-2.5-flash      # set to a current model id
AI_INPUT_COST_PAISE_PER_1K=3       # estimates used for spend caps — match your Google billing
AI_OUTPUT_COST_PAISE_PER_1K=25

# ---- Background worker -----------------------------------------------------------
WORKER_IN_PROCESS=true             # local (PGlite) must be true; production: false + separate worker service
WORKER_POLL_MS=1000
CAMPAIGN_SEND_RATE_PER_SECOND=20   # pacing, well below Meta's default throughput
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_SECONDS=15

# ---- Later phases (not used yet) --------------------------------------------
# Phase 6 billing. BILLING_PROVIDER=mock (default) takes no payments. razorpay needs all three keys; production must use razorpay.
BILLING_PROVIDER=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---- Web (apps/web) — build-time, PUBLIC values only ---------------------------
VITE_API_URL=                      # prod: https://api.socialpilot.digimithra.co.in
